# Copy this file to .env and fill in the two REQUIRED values.
# .env is git-ignored. Never commit real secrets.
# Compose refuses to start if any REQUIRED value is empty.

# --- REQUIRED ---------------------------------------------------------------
POSTGRES_PASSWORD=
VENDOR_WEBHOOK_SECRET=

# --- Database ---------------------------------------------------------------
POSTGRES_DB=edupulse
POSTGRES_USER=edupulse
# Host port for Postgres (bound to localhost only). Use 5433 if a local
# Postgres already uses 5432.
POSTGRES_HOST_PORT=5432

# --- Embeddings -------------------------------------------------------------
# Ollama must be running with the model pulled: ollama pull nomic-embed-text
# From containers, the host is reached via host.docker.internal (Compose default).
OLLAMA_BASE_URL=http://host.docker.internal:11434
APP_EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model (768 for nomic-embed-text, 1024 for mxbai-embed-large).
# Changing the model later means re-indexing.
EMBEDDING_DIMENSIONS=768

# --- Placeholders -----------------------------------------------------------
# These are passed to the containers but are NOT bound to any code yet.
# Map them to your own properties (e.g. app.chunk-size=${APP_CHUNK_SIZE}).

# ingest-static
APP_CHUNK_SIZE=800
APP_CHUNK_OVERLAP=100

# ingest-dynamic
# SSRF: Compose only signals this. The actual block of localhost, private IP
# ranges and cloud metadata addresses must be implemented in ingest-dynamic.
APP_INGEST_BLOCK_PRIVATE_NETWORKS=true
# Comma-separated, e.g. docs.spring.io,example.org
APP_INGEST_ALLOWED_DOMAINS=
APP_INGEST_MAX_BYTES=10485760
APP_INGEST_TIMEOUT_SECONDS=15

# retrieval-pre
APP_QUERY_EXPANSION_VARIANTS=3

# retrieval-post
APP_RERANK_TOP_N=20
APP_RERANK_TOP_K=5
APP_SIMILARITY_THRESHOLD=0.5
